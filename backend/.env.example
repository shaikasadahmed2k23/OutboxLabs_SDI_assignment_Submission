# ── Database (Supabase Postgres) ─────────────────────────────────
# Supabase dashboard → Connect → ORM → Prisma. Two URLs are required:
# DATABASE_URL  = pooled connection (port 6543, pgbouncer=true) — used at runtime by the app
# DIRECT_URL    = direct connection (port 5432) — used only by `prisma migrate` (PgBouncer can't run DDL)
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres"

# ── Redis (BullMQ backing store + rate-limit counters) ──────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Ethereal SMTP (fake SMTP for testing) ────────────────────────
# Generate a test account at https://ethereal.email/create
# or programmatically via nodemailer.createTestAccount()
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587

# ── Worker tuning ─────────────────────────────────────────────────
# Number of jobs the worker processes in parallel
WORKER_CONCURRENCY=5

# Minimum delay (ms) enforced between individual email sends,
# per worker slot, to mimic provider throttling
MIN_DELAY_BETWEEN_SENDS_MS=2000

# ── Rate limiting ──────────────────────────────────────────────
# Global fallback cap if a Sender has no per-sender maxPerHour set
MAX_EMAILS_PER_HOUR=200

# ── Slack OAuth (for rate-limit-hit notifications) ────────────
# Create an app at https://api.slack.com/apps → OAuth & Permissions
# Add redirect URL: http://localhost:4000/auth/slack/callback
# Bot Token Scopes: incoming-webhook, chat:write
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/auth/slack/callback

# ── Elasticsearch (email search indexing) ────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ── Server ────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
