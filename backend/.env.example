# ── Database (Supabase Postgres connection string) ──────────────
# Supabase dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ── Redis (BullMQ backing store + rate-limit counters) ──────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Ethereal SMTP (fake SMTP for testing) ────────────────────────
# Generate a test account at https://ethereal.email/create
# or programmatically via nodemailer.createTestAccount()
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587

# ── Worker tuning ─────────────────────────────────────────────────
# Number of jobs the worker processes in parallel
WORKER_CONCURRENCY=5

# Minimum delay (ms) enforced between individual email sends,
# per worker slot, to mimic provider throttling
MIN_DELAY_BETWEEN_SENDS_MS=2000

# ── Rate limiting ──────────────────────────────────────────────
# Global fallback cap if a Sender has no per-sender maxPerHour set
MAX_EMAILS_PER_HOUR=200

# ── Slack OAuth (for rate-limit-hit notifications) ────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/auth/slack/callback

# ── Server ────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
